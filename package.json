{
  "name": "sam-snippets",
  "displayName": "AWS Serverless Application Model (SAM) Snippets",
  "description": "Adds snippets for all the AWS Serverless Application Model (SAM) resources in VS Code.",
  "author": "Danny Steenman",
  "version": "1.20.0",
  "publisher": "dannysteenman",
  "icon": "images/sam-snippets-extension-icon.png",
  "homepage": "https://towardsthecloud.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/towardsthecloud/vscode-sam-snippets.git"
  },
  "engines": {
    "vscode": "^1.31.0"
  },
  "galleryBanner": {
    "color": "#2B2C33",
    "theme": "dark"
  },
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "aws",
    "serverless",
    "sam",
    "template",
    "yml"
  ],
  "scripts": {
    "test": "npm run generate:check && npm run package && npm run test:package && npm run test:editor && npm run test:templates",
    "test:editor": "node scripts/test-editor.mjs",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "schema:update": "node scripts/update-schema.mjs",
    "test:templates": "node scripts/validate-templates.mjs",
    "package": "node -e \"require('node:fs').mkdirSync('.test-artifacts', {recursive: true})\" && vsce package --no-dependencies --out .test-artifacts/sam-snippets.vsix",
    "test:package": "node scripts/validate-package.mjs"
  },
  "files": [
    "snippets/*.json",
    "images/sam-snippets-extension-icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "overrides": {
    "ovsx": {
      "@vscode/vsce": "$@vscode/vsce"
    }
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "ovsx": "1.2.0",
    "yaml": "2.9.1"
  },
  "contributes": {
    "snippets": [
      {
        "language": "yaml",
        "path": "./snippets/yaml-condition-functions.json"
      },
      {
        "language": "yaml",
        "path": "./snippets/yaml-intrinsic-functions.json"
      },
      {
        "language": "yaml",
        "path": "./snippets/yaml-sam-resource-types.json"
      }
    ]
  }
}
